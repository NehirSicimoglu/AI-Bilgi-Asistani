# ---- Uygulama ----
APP_NAME="AI Knowledge Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1
# Frontend origin(ler)i (JSON dizi)
CORS_ORIGINS=["http://localhost:5173"]
# health/metrics dışındaki tüm uçlar için paylaşılan anahtar (X-API-Key header'ı).
# Boş bırakılırsa uçlar korumasız kalır — production'da mutlaka ayarlayın.
# Frontend'in VITE_API_KEY değeri bununla birebir aynı olmalıdır.
API_KEY=

# ---- LLM (Google Gemini) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest
# Sorgu yeniden yazma / alt-sorgu bölme gibi yardımcı çağrılar için daha hafif model
LLM_REWRITE_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# ---- Embedding (Google) ----
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ---- Sparse encoder (hybrid retrieval, BM25) ----
SPARSE_ENCODER=bm25

# ---- Vector store (Qdrant) ----
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ---- Veritabanı (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ---- Chunking / Retrieval ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=hybrid

# ---- Query Decomposition (çapraz-belge çoklu-sorgu getirme) ----
# Cevabı birden çok belgeden bilgi birleştirmeyi gerektiren sorularda soruyu
# alt-sorgulara böler. Varsayılan kapalı; açmak ekstra LLM çağrısı maliyeti getirir.
ENABLE_QUERY_DECOMPOSITION=false
DECOMPOSITION_MAX_SUBQUERIES=3
SUBQUERY_TOP_K=3

# ---- Konuşma / bellek ----
# Prompt ve sorgu yeniden yazmaya verilecek en son mesaj sayısı
CHAT_HISTORY_MESSAGES=10

# ---- Dosya yükleme ----
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=[".pdf",".docx",".xlsx",".txt",".md"]
